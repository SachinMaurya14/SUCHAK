# ==============================================================================
# SUCHAK Enterprise HSE Platform — Environment Configuration Template
# NOTE: Never commit actual production secrets or private credentials here.
# ==============================================================================

# Application Environment ('development', 'staging', 'production')
NODE_ENV=development
APP_ENV=development

# Server Networking
PORT=3000
API_BASE_URL=/api/v1
VITE_API_BASE_URL=

# CORS Allowed Origins (Comma-separated or '*' in local dev)
CORS_ORIGINS=*

# Cryptographic Session & Token Signing Key
# In production, must be at least 32 characters of high-entropy randomness
# Generate using: openssl rand -hex 32
SECRET_KEY=

# Enterprise Database Connectivity (PostgreSQL Target Architecture)
# Format: postgresql://username:password@hostname:5432/suchak_db
DATABASE_URL=
TEST_DATABASE_URL=

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Google Gemini Safety Intelligence Engine (Server-side only)
# Required for real-time generative safety explanations & causal synthesis
GEMINI_API_KEY=
